# Port the server listens on (most hosts set this for you)
PORT=3000

# Where the SQLite database file is stored
DB_PATH=./data/survey.db

# Admin panel login — username is always "admin"
ADMIN_PASSWORD=change-me

# Shared secret that must appear as ?key=... on the Twilio webhook URLs,
# so random internet traffic can't post fake votes. Put the same value
# in the Twilio phone number's Voice webhook URL.
VOICE_WEBHOOK_SECRET=change-me-too
